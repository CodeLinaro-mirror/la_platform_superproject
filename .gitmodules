[submodule "platform/packages/apps/Car/Templates"]
	branch = car-app-host-main
	path = packages/apps/Car/Templates
	url = ../packages/apps/Car/Templates
[submodule "platform/prebuilts/fullsdk-linux/build-tools"]
	branch = ub-automotive-main
	shallow = true
	path = prebuilts/fullsdk-linux/build-tools
	url = ../prebuilts/fullsdk-linux/build-tools
[submodule "platform/prebuilts/fullsdk-linux/platform-tools"]
	branch = ub-automotive-main
	shallow = true
	path = prebuilts/fullsdk-linux/platform-tools
	url = ../prebuilts/fullsdk-linux/platform-tools
[submodule "platform/prebuilts/fullsdk/platforms"]
	branch = androidx-main
	shallow = true
	path = prebuilts/fullsdk-darwin/platforms
	url = ../prebuilts/fullsdk/platforms
[submodule "platform/prebuilts/jdk/jdk21"]
	branch = main
	shallow = true
	path = prebuilts/jdk/jdk21
	url = ../prebuilts/jdk/jdk21
[submodule "platform/prebuilts/sdk"]
	branch = android16-release
	shallow = true
	path = prebuilts/sdk
	url = ../prebuilts/sdk
[submodule "platform/tools/external/gradle"]
	branch = androidx-main
	shallow = true
	path = tools/external/gradle
	url = ../tools/external/gradle
